doctype html
html
  head
    title Crear Nueva Publicación - Fotaza 2
    link(rel="stylesheet", href="/style/index.css")
    style.

      .body-subir-foto {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      .body-subir-foto .container-subir {
        margin: auto;
        background-color: #262626;
        border: 1px solid #333;
        border-radius: 8px;
        padding: 30px;
        width: 100%;
        max-width: 450px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
      }
      .form-group { margin-bottom: 20px; }
      label { display: block; margin-bottom: 8px; font-size: 14px; color: #cccccc; }
      input[type="text"], input[type="file"], textarea {
        width: 100%; padding: 10px; background-color: #1a1a1a;
        border: 1px solid #444; border-radius: 4px; color: white;
        box-sizing: border-box;
      }
      .btn-submit {
        background-color: #28a745; color: white; border: none;
        padding: 12px; width: 100%; border-radius: 4px; font-weight: bold; cursor: pointer;
      }

  body.body-subir-foto
    include partials/header.pug
    
    div.container-subir
      h2(style="text-align: center; margin-bottom: 20px;") Crear nueva 
        span(style="color: #ff4500;") publicación
      
      form(action="/subir", method="POST", enctype="multipart/form-data")
        div.form-group
          label Título de la foto:
          input(type="text", name="titulo", required=true, placeholder="Tu título aquí")
        
        div.form-group
          label Seleccionar Imágenes:
          input(type="file", name="imagenes", accept="image/*", multiple=true, required=true)

        div.form-group
          label Descripción:
          textarea(name="descripcion", rows="4", placeholder="Tu descripción aquí...")
        
        div.form-group
          label(for="etiquetas") Etiquetas (separadas por coma):
          input(type="text", name="etiquetas", id="etiquetas", placeholder="ej: naturaleza, minimalista")
        
        button.btn-submit(type="submit") ➕ Publicar Foto