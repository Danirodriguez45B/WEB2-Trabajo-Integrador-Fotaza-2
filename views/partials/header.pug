header
  div.nav-container(style="display: flex; justify-content: space-between; align-items: center; width: 100%; padding: 10px 20px; box-sizing: border-box;")
    h1
      a(href="/" style="text-decoration: none; color: white;") Fotaza
    
    //- Contenedor del buscador
    div.search-wrapper(style="position: relative; z-index: 1000;")
      form(action="/buscar", method="GET", style="display: flex; gap: 5px;")
        input(type="text", name="q", id="search-input", placeholder="Buscar...", autocomplete="off", style="padding: 5px;")
        
        div#search-options(style="position: absolute; top: 120%; left: 0; background: #262626; border: 1px solid #444; padding: 15px; border-radius: 8px; width: 200px; display: none; z-index: 9999;")
          label(style="display: block; color: white; cursor: pointer;")
            input(type="radio", name="tipo", value="tags", checked) 
            | Tags
          label(style="display: block; color: white; cursor: pointer;")
            input(type="radio", name="tipo", value="Usuario") 
            | Usuario
          label(style="display: block; color: white; cursor: pointer;")
            input(type="radio", name="tipo", value="titulo") 
            | Título
            
        button(type="submit") 🔍

    div.nav-buttons
      if usuario
        span(style="margin-right: 15px; color: #ff8c00; font-weight: bold;") Hola #{usuario.username}
        a(href="/subir", style="margin-right: 15px; color: white; text-decoration: none;") Publicar
        a(href="/perfil/" + usuario.username, style="margin-right: 15px; color: white; text-decoration: none;") Perfil
        a(href="/logout", style="color: #ff4500; text-decoration: none;") Salir 🚪
      else
        a(href="/login", style="margin-right: 15px; color: white; text-decoration: none;") Iniciar Sesión
        a(href="/registro", class="btn-register", style="text-decoration: none;") Crear Cuenta